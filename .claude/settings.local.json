{
  "permissions": {
    "allow": [
      "Bash(rm -f out/main.fdb_latexmk out/main.fls out/main.aux)",
      "Bash(latexmk -xelatex -synctex=1 -interaction=nonstopmode -file-line-error main.tex --outdir=out)",
      "Bash(while read f)",
      "Bash(do)",
      "Bash(if [ -f \"/mdata/linjunfeng/thuthesis/data/figures/$f\" ])",
      "Bash(then echo \"✓ $f\")",
      "Bash(else echo \"✗ MISSING: $f\")",
      "Read(//mdata/linjunfeng/thuthesis/**)",
      "Bash(while read img)",
      "Bash(if [ ! -f \"/mdata/linjunfeng/thuthesis/data/figures/$img\" ])",
      "Bash(then)",
      "Bash(echo \"MISSING: $img\")",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:dblp.org)",
      "WebFetch(domain:scholar.google.com)",
      "WebFetch(domain:proceedings.mlsys.org)",
      "WebFetch(domain:www.usenix.org)",
      "WebFetch(domain:dl.acm.org)"
    ]
  }
}
