      "value": "http://api.llm.will/claude"
    },
    {
      "name": "ANTHROPIC_API_KEY",
      "value": "sk-OIQJSyLbmdO1Dne_OUyhZcyji0Drkx3ZEPADPVs1X2jUfR9rK0R0KBC9PvE"
    },
    {
    "name": "ANTHROPIC_DEFAULT_SONNET_MODEL",
    "value": "coding/claude-sonnet-4-6"
    },
  {
    "name": "ANTHROPIC_DEFAULT_OPUS_MODEL",
